<% page_title "Sign in" %>
<div class="mx-auto w-full max-w-md">
  <div class="mb-6 text-center">
    <div class="text-4xl" aria-hidden="true">⛪</div>
    <h1 class="mt-2 text-2xl font-bold">Church Attendance</h1>
    <p class="text-sm text-slate-500">Sign in to manage attendees, events and scanning.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: label_classes %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: input_classes %>
      </div>
      <div>
        <%= f.label :password, class: label_classes %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: input_classes %>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
          Remember me on this device
        </label>
      <% end %>
      <%= f.submit "Sign in", class: button_classes(:primary, "w-full") %>
    <% end %>
    <p class="mt-4 text-center text-sm">
      <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-indigo-600 hover:underline" %>
    </p>
  </div>
</div>
