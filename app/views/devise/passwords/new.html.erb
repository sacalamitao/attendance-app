<% page_title "Reset password" %>
<div class="mx-auto w-full max-w-md">
  <h1 class="mb-4 text-2xl font-bold">Forgot your password?</h1>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= form_with model: resource, as: resource_name, url: password_path(resource_name), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: label_classes %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: input_classes %>
      </div>
      <%= f.submit "Send reset instructions", class: button_classes(:primary, "w-full") %>
    <% end %>
    <p class="mt-4 text-center text-sm"><%= link_to "Back to sign in", new_session_path(resource_name), class: "text-indigo-600 hover:underline" %></p>
  </div>
</div>
