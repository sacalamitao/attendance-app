<% page_title "Choose a new password" %>
<div class="mx-auto w-full max-w-md">
  <h1 class="mb-4 text-2xl font-bold">Choose a new password</h1>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :put, class: "space-y-4" do |f| %>
      <%= f.hidden_field :reset_password_token %>
      <div>
        <%= f.label :password, "New password", class: label_classes %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: input_classes %>
        <% if @minimum_password_length %><p class="mt-1 text-xs text-slate-500"><%= @minimum_password_length %> characters minimum</p><% end %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: label_classes %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: input_classes %>
      </div>
      <%= f.submit "Change my password", class: button_classes(:primary, "w-full") %>
    <% end %>
  </div>
</div>
