<% page_title @event.name %>
<%= render layout: "header", locals: { event: @event } do %>
  <% if policy(@event).update? %>
    <%= link_to "Edit", edit_event_path(@event), class: button_classes(:secondary) %>
  <% end %>
  <% if @event.draft? && policy(@event).open? %>
    <%= button_to "Open event", open_event_path(@event), method: :post, class: button_classes(:success),
          form: { data: { turbo_confirm: "Open #{@event.name} for attendance? Scanning can begin immediately." } } %>
  <% end %>
  <% if @event.open? %>
    <% if policy(@event).scan? %><%= link_to "Scan attendance", scanner_event_path(@event), class: button_classes(:success) %><% end %>
    <%= link_to "View dashboard", dashboard_event_path(@event), class: button_classes(:secondary) %>
    <% if policy(@event).close? %>
      <%= button_to "Close event", close_event_path(@event), method: :post, class: button_classes(:danger),
            form: { data: { turbo_confirm: "Close #{@event.name}? No more scans will be accepted and attendance becomes final." } } %>
    <% end %>
  <% end %>
  <% if @event.closed? %>
    <%= link_to "View final results", dashboard_event_path(@event), class: button_classes(:secondary) %>
    <% if policy(@event).report? %><%= link_to "Download report (.xlsx)", report_event_path(@event), class: button_classes(:primary), data: { turbo: false } %><% end %>
  <% end %>
<% end %>

<% if @event.closed? && policy(@event).reopen? %>
  <section class="mb-6 rounded-xl border border-amber-300 bg-amber-50 p-4" aria-labelledby="reopen-event">
    <h2 id="reopen-event" class="font-semibold text-amber-950">Reopen this event</h2>
    <p class="mt-1 text-sm text-amber-900">Reopening allows attendance scans again. Confirm this sensitive action with your current password.</p>
    <%= form_with url: reopen_event_path(@event), method: :post, class: "mt-3 flex flex-col gap-2 sm:flex-row" do |f| %>
      <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Current password",
            "aria-label": "Current password", class: input_classes("sm:max-w-xs") %>
      <%= f.submit "Reopen event", class: button_classes(:danger),
            data: { turbo_confirm: "Reopen #{@event.name}? Attendance scanning will become available again." } %>
    <% end %>
  </section>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2" aria-labelledby="event-details">
    <h2 id="event-details" class="mb-3 text-lg font-semibold">Details</h2>
    <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
      <div><dt class="text-slate-500">Date</dt><dd class="font-medium"><%= l(@event.event_date, format: :long_weekday) %></dd></div>
      <div><dt class="text-slate-500">Time</dt><dd class="font-medium"><%= @event.time_range %></dd></div>
      <div><dt class="text-slate-500">Location</dt><dd class="font-medium"><%= @event.location %></dd></div>
      <div><dt class="text-slate-500">Status</dt><dd class="font-medium"><%= @event.status.titleize %></dd></div>
      <% if @event.opened_at %><div><dt class="text-slate-500">Opened</dt><dd class="font-medium"><%= l(@event.opened_at, format: :short_datetime) %></dd></div><% end %>
      <% if @event.closed_at %><div><dt class="text-slate-500">Closed</dt><dd class="font-medium"><%= l(@event.closed_at, format: :short_datetime) %></dd></div><% end %>
    </dl>
    <% if @event.draft? %>
      <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-600">This event is a draft. Open it to start accepting QR scans.</p>
    <% end %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-labelledby="attendance-summary">
    <h2 id="attendance-summary" class="mb-3 text-lg font-semibold">Attendance</h2>
    <dl class="space-y-2 text-sm">
      <div class="flex justify-between"><dt class="text-slate-500">Registered</dt><dd class="font-semibold"><%= @summary.registered %></dd></div>
      <div class="flex justify-between"><dt class="text-slate-500">Present</dt><dd class="font-semibold text-emerald-700"><%= @summary.present %></dd></div>
      <div class="flex justify-between"><dt class="text-slate-500">Absent</dt><dd class="font-semibold text-rose-700"><%= @summary.absent %></dd></div>
      <div class="flex justify-between border-t border-slate-200 pt-2"><dt class="text-slate-500">Attendance</dt><dd class="text-xl font-bold"><%= percentage(@summary.percentage) %></dd></div>
    </dl>
  </section>
</div>
