<% page_title "#{@event.name} · Dashboard" %>
<%= turbo_stream_from @event %>
<div data-controller="auto-refresh" data-auto-refresh-interval-value="<%= @event.open? ? 20000 : 0 %>">
  <%= render layout: "header", locals: { event: @event } do %>
    <% if @event.open? && policy(@event).scan? %>
      <%= link_to "Scan attendance", scanner_event_path(@event), class: button_classes(:success) %>
    <% end %>
    <% if @event.open? && policy(@event).close? %>
      <%= button_to "Close event", close_event_path(@event), method: :post, class: button_classes(:danger),
            form: { data: { turbo_confirm: "Close #{@event.name}? No more scans will be accepted and attendance becomes final." } } %>
    <% end %>
    <% if policy(@event).report? %>
      <%= link_to "Download report (.xlsx)", report_event_path(@event), class: button_classes(:primary), data: { turbo: false } %>
    <% end %>
    <% if @event.closed? && policy(@event).reopen? %>
      <%= link_to "Reopen event", event_path(@event, anchor: "reopen-event"), class: button_classes(:danger) %>
    <% end %>
  <% end %>

  <% if @event.closed? %>
    <p class="mb-4 rounded-lg border border-slate-300 bg-slate-100 px-4 py-2 text-sm text-slate-700">Final results. This event is closed and no longer accepts scans.</p>
  <% elsif @event.open? %>
    <p class="mb-4 text-xs text-slate-500" data-auto-refresh-target="status">Live · updates automatically as scans come in.</p>
  <% end %>

  <dl class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% [["Registered", @summary.registered, ""], ["Present", @summary.present, "text-emerald-700"], ["Absent", @summary.absent, "text-rose-700"], ["Attendance", percentage(@summary.percentage), "text-indigo-700"]].each do |label, value, color| %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></dt>
        <dd class="mt-1 text-3xl font-bold <%= color %>"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <section class="mb-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-labelledby="ministry-breakdown">
    <h2 id="ministry-breakdown" class="px-4 pt-4 text-lg font-semibold">Ministry breakdown</h2>
    <div class="overflow-x-auto">
      <table class="mt-2 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <tr>
            <th scope="col" class="px-4 py-2">Ministry</th>
            <th scope="col" class="px-4 py-2 text-right">Registered</th>
            <th scope="col" class="px-4 py-2 text-right">Present</th>
            <th scope="col" class="px-4 py-2 text-right">Absent</th>
            <th scope="col" class="px-4 py-2 text-right">Attendance</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @breakdown.each do |row| %>
            <tr>
              <td class="px-4 py-2"><%= ministry_badge(row.code) %></td>
              <td class="px-4 py-2 text-right"><%= row.registered %></td>
              <td class="px-4 py-2 text-right font-semibold text-emerald-700"><%= row.present %></td>
              <td class="px-4 py-2 text-right text-rose-700"><%= row.absent %></td>
              <td class="px-4 py-2 text-right">
                <div class="flex items-center justify-end gap-2">
                  <div class="h-2 w-24 overflow-hidden rounded-full bg-slate-200" aria-hidden="true"><div class="h-full bg-indigo-500" style="width: <%= row.percentage %>%"></div></div>
                  <span class="w-14 font-medium"><%= percentage(row.percentage) %></span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-labelledby="attendee-lists">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
      <div class="flex gap-1" role="tablist" aria-label="Attendee lists">
        <% [["present", "Present (#{@summary.present})"], ["absent", "Absent (#{@summary.absent})"]].each do |key, label| %>
          <%= link_to label, dashboard_event_path(@event, tab: key, q: params[:q]), role: "tab", "aria-selected": (@tab == key).to_s,
                class: "rounded-md px-3 py-1.5 text-sm font-semibold #{@tab == key ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'}" %>
        <% end %>
      </div>
      <%= form_with url: dashboard_event_path(@event), method: :get, class: "flex gap-2" do |f| %>
        <%= f.hidden_field :tab, value: @tab %>
        <%= f.search_field :q, value: params[:q], placeholder: "Search name", "aria-label": "Search attendees", class: input_classes("py-1.5") %>
        <%= f.submit "Search", class: button_classes(:secondary, "py-1.5") %>
      <% end %>
    </div>
    <h2 id="attendee-lists" class="sr-only"><%= @tab.titleize %> attendees</h2>
    <% if @rows.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr>
              <th scope="col" class="px-4 py-2">Full name</th>
              <th scope="col" class="px-4 py-2">Age</th>
              <th scope="col" class="px-4 py-2">Gender</th>
              <th scope="col" class="px-4 py-2"><%= @tab == "present" ? "Ministry" : "Current ministry" %></th>
              <th scope="col" class="px-4 py-2"><%= @tab == "present" ? "Scan time" : "Status" %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @rows.each do |row| %>
              <% attendee = @tab == "present" ? row.attendee : row %>
              <tr>
                <td class="px-4 py-2 font-medium"><%= link_to attendee.full_name, attendee, class: "hover:underline" %></td>
                <td class="px-4 py-2"><%= attendee.age(on: @event.event_date) %></td>
                <td class="px-4 py-2"><%= Gender.label(attendee.gender) %></td>
                <td class="px-4 py-2"><%= ministry_badge(@tab == "present" ? row.ministry_classification : attendee.ministry_on(@event.event_date)) %></td>
                <% if @tab == "present" %>
                  <td class="px-4 py-2 text-slate-600"><span class="mr-1 text-emerald-600" aria-hidden="true">✓</span><%= l(row.scanned_at, format: :scan) %></td>
                <% else %>
                  <td class="px-4 py-2"><span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-800 ring-1 ring-inset ring-rose-200">Absent</span></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", pager: @pager %>
    <% else %>
      <%= render "shared/empty_state", title: (@tab == "present" ? "Nobody has been scanned yet" : "No absent attendees"), hint: (params[:q].present? ? "No names match your search." : nil) %>
    <% end %>
  </section>
</div>
