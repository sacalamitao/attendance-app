<% page_title @attendee.full_name %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="text-sm"><%= link_to "← Attendees", attendees_path, class: "text-indigo-600 hover:underline" %></p>
    <h1 class="mt-1 text-2xl font-bold"><%= @attendee.full_name %></h1>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <%= ministry_badge(@attendee.current_ministry) %>
      <%= attendee_status_badge(@attendee) %>
    </div>
  </div>
  <% if policy(@attendee).update? %>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit", edit_attendee_path(@attendee), class: button_classes(:secondary) %>
      <% if @attendee.active? %>
        <%= button_to "Deactivate", attendee_path(@attendee), method: :delete, class: button_classes(:danger),
              form: { data: { turbo_confirm: "Deactivate #{@attendee.full_name}? Their QR code will stop working, but attendance history is kept." } } %>
      <% else %>
        <%= button_to "Reactivate", reactivate_attendee_path(@attendee), method: :post, class: button_classes(:success) %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-labelledby="details">
      <h2 id="details" class="mb-3 text-lg font-semibold">Details</h2>
      <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
        <div><dt class="text-slate-500">Age</dt><dd class="font-medium"><%= @attendee.age %></dd></div>
        <div><dt class="text-slate-500">Birthdate</dt><dd class="font-medium"><%= l(@attendee.birthdate, format: :long_weekday) %></dd></div>
        <div><dt class="text-slate-500">Gender</dt><dd class="font-medium"><%= Gender.label(@attendee.gender) %></dd></div>
        <div><dt class="text-slate-500">Current ministry</dt><dd class="font-medium"><%= @attendee.current_ministry_label || "Not classifiable" %></dd></div>
        <div><dt class="text-slate-500">Added</dt><dd class="font-medium"><%= l(@attendee.created_at, format: :short_datetime) %></dd></div>
        <% unless @attendee.active? %>
          <div><dt class="text-slate-500">Deactivated</dt><dd class="font-medium"><%= l(@attendee.deactivated_at, format: :short_datetime) %></dd></div>
        <% end %>
      </dl>
    </section>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-labelledby="history">
      <h2 id="history" class="px-6 pt-5 text-lg font-semibold">Attendance history</h2>
      <% if @attendances.any? %>
        <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr><th class="px-6 py-2">Event</th><th class="px-6 py-2">Date</th><th class="px-6 py-2">Ministry then</th><th class="px-6 py-2">Scanned</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @attendances.each do |attendance| %>
              <tr>
                <td class="px-6 py-2 font-medium"><%= link_to attendance.event.name, dashboard_event_path(attendance.event), class: "hover:underline" %></td>
                <td class="px-6 py-2"><%= l(attendance.event.event_date, format: :short) %></td>
                <td class="px-6 py-2"><%= ministry_badge(attendance.ministry_classification) %></td>
                <td class="px-6 py-2 text-slate-500"><%= l(attendance.scanned_at, format: :short_datetime) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 pb-6 pt-2 text-sm text-slate-500">No attendance recorded yet.</p>
      <% end %>
    </section>
  </div>

  <section class="rounded-xl border border-slate-200 bg-white p-6 text-center shadow-sm" aria-labelledby="qr">
    <h2 id="qr" class="mb-3 text-lg font-semibold">QR code</h2>
    <div class="mx-auto max-w-xs rounded-lg border border-slate-200 bg-white p-2">
      <%= qr_code_svg(@attendee) %>
    </div>
    <p class="mt-2 text-xs text-slate-500">Encodes an opaque token only. No personal details are stored in the code.</p>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <%= link_to "Download PNG", qr_attendee_path(@attendee, format: :png, download: 1), class: button_classes(:primary) %>
      <%= link_to "Download SVG", qr_attendee_path(@attendee, format: :svg, download: 1), class: button_classes(:secondary) %>
      <button type="button" class="<%= button_classes(:secondary) %>" onclick="window.print()">Print</button>
    </div>
  </section>
</div>
