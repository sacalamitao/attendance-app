  <p class="mb-4 text-sm text-slate-500">Changing birthdate or gender updates the current ministry. Past attendance keeps its original classification.</p>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", attendee: @attendee %>
  </div>
</div>
