<% page_title "Dashboard" %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">Dashboard</h1>
    <p class="text-sm text-slate-500"><%= l(Date.current, format: :long_weekday) %></p>
  </div>
  <% if policy(Event).create? %>
    <div class="flex gap-2">
      <%= link_to "New attendee", new_attendee_path, class: button_classes(:secondary) %>
      <%= link_to "New event", new_event_path, class: button_classes(:primary) %>
    </div>
  <% end %>
</div>

<dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% [
    ["Active attendees", @stats[:attendees]],
    ["Events", @stats[:events]],
    ["Closed events", @stats[:closed_events]],
    ["Avg. attendance (recent)", @stats[:average_attendance] ? percentage(@stats[:average_attendance]) : "—"]
  ].each do |label, value| %>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></dt>
      <dd class="mt-1 text-2xl font-bold"><%= value %></dd>
    </div>
  <% end %>
</dl>

<section class="mb-8" aria-labelledby="open-events">
  <h2 id="open-events" class="mb-3 text-lg font-semibold">Open now</h2>
  <% if @open_events.any? %>
    <div class="grid gap-3 sm:grid-cols-2">
      <% @open_events.each do |event| %>
        <div class="rounded-xl border-2 border-emerald-300 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-semibold"><%= link_to event.name, event, class: "hover:underline" %></h3>
              <p class="text-sm text-slate-500"><%= l(event.event_date, format: :short) %> · <%= event.time_range %> · <%= event.location %></p>
            </div>
            <%= event_status_badge(event) %>
          </div>
          <p class="mt-2 text-sm"><span class="font-semibold"><%= event.attendance_count %></span> present so far</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= link_to "Scan attendance", scanner_event_path(event), class: button_classes(:success) %>
            <%= link_to "Dashboard", dashboard_event_path(event), class: button_classes(:secondary) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">No events are open for attendance right now.</p>
  <% end %>
</section>

<div class="grid gap-8 lg:grid-cols-2">
  <section aria-labelledby="upcoming-events">
    <h2 id="upcoming-events" class="mb-3 text-lg font-semibold">Upcoming</h2>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <% if @upcoming_events.any? %>
        <ul class="divide-y divide-slate-200">
          <% @upcoming_events.each do |event| %>
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <div>
                <%= link_to event.name, event, class: "font-medium hover:underline" %>
                <p class="text-sm text-slate-500"><%= l(event.event_date, format: :short) %> · <%= event.time_range %></p>
              </div>
              <%= event_status_badge(event) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", title: "No upcoming events", hint: "Create an event to start planning attendance." %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="recent-events">
    <h2 id="recent-events" class="mb-3 text-lg font-semibold">Recently closed</h2>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <% if @recent_events.any? %>
        <ul class="divide-y divide-slate-200">
          <% @recent_events.each do |event| %>
            <% summary = EventDashboardQuery.new(event).summary %>
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <div>
                <%= link_to event.name, dashboard_event_path(event), class: "font-medium hover:underline" %>
                <p class="text-sm text-slate-500"><%= l(event.event_date, format: :short) %> · <%= summary.present %> of <%= summary.registered %> present</p>
              </div>
              <span class="text-lg font-bold"><%= percentage(summary.percentage) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", title: "No closed events yet" %>
      <% end %>
    </div>
  </section>
</div>
