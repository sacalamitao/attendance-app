<% page_title "Offline" %>
<div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-center">
  <div class="text-4xl" aria-hidden="true">📡</div>
  <h1 class="mt-2 text-xl font-bold text-amber-900">You're offline</h1>
  <p class="mt-2 text-sm text-amber-800">This page could not be loaded because the device has no network connection. Attendance scans are only saved once they reach the server, so nothing has been recorded while offline.</p>
  <a href="/" class="<%= button_classes(:primary, 'mt-5') %>">Try again</a>
</div>
